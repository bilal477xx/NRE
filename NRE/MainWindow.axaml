<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:NRE.Views"
        x:CompileBindings="False"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="910"
        Height="910" Width="1440" RequestedThemeVariant="Light"
        WindowStartupLocation="CenterScreen"
        x:Class="NRE.MainWindow" Background="White"
        Closing="Window_OnClosing"
        Opened="TopLevel_OnOpened"
        Title="NRE">
    <Window.Styles>
        <Style Selector="Label">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="TextBox, ComboBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>

        <Style Selector="ComboBoxItem">
            <Setter Property="Padding" Value="16,8"/>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>

        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="Button.action">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="ListBox.items">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="16,0"/>
            <Setter Property="SelectionMode" Value="Single, Toggle"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>
    </Window.Styles>
    
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem x:Name="MnuNew" Header="New" Click="MnuNew_OnClick"/>
                <MenuItem x:Name="MnuOpen" Header="Open"/>
                <MenuItem x:Name="MnuSave" Header="Save" Click="MnuSave_OnClick"/>
                <MenuItem x:Name="MnuSaveAs" Header="Save As">
                    <MenuItem x:Name="MnuSaveAsXml" Header="Xml" Click="MnuSaveAsXml_OnClick"/>
                    <MenuItem x:Name="MnuSaveAsJson" Header="Json" Click="MnuSaveAsJson_OnClick"/>
                </MenuItem>
                <MenuItem x:Name="MnuLoad" Header="Load" Click="MnuLoad_OnClick"/>
                <Separator/>
                <MenuItem x:Name="MnuExit" Header="Exit" Click="MnuExit_OnClick"/>
            </MenuItem>
        </Menu>
        
        <Grid RowDefinitions="Auto,*" Margin="16">
            <TextBlock Grid.Row="0"
                       Text="Welcome to Nordic Real Estate"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,8"/>

            <TabControl Grid.Row="1">
                <TabItem Header="Estates">
                    <views:EstatesView x:Name="EstatesTab"/>
                </TabItem>
                <TabItem Header="People">
                    <views:PeopleView x:Name="PeopleTab"/>
                </TabItem>
                <TabItem Header="Payments">
                    <views:PaymentsView x:Name="PaymentsTab"/>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>


</Window>
